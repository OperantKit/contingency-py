{
  "description": "Timeout(FR(2), duration=3, reset_on_response=false): the reinforcer at t=2 starts a timeout ending at t=5. The response at t=3 and the tick at t=4 fall inside it and are dropped (timeout_active); with reset_on_response=false the response does not extend it. The response at t=5 is at the boundary and counts toward the next FR(2), which reinforces at t=6.",
  "name": "timeout-fr2-to3",
  "schedule": {
    "params": {
      "duration": 3.0,
      "inner": {
        "params": {
          "n": 2
        },
        "type": "FR"
      },
      "reset_on_response": false
    },
    "type": "Timeout"
  },
  "steps": [
    {
      "event": {
        "operandum": "main",
        "time": 1.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 1.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 2.0
      },
      "expect": {
        "meta": {
          "timeout_started": true
        },
        "reinforced": true,
        "reinforcer": {
          "label": "SR+",
          "magnitude": 1.0,
          "time": 2.0
        }
      },
      "now": 2.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 3.0
      },
      "expect": {
        "meta": {
          "timeout_active": true
        },
        "reinforced": false
      },
      "now": 3.0
    },
    {
      "event": null,
      "expect": {
        "meta": {
          "timeout_active": true
        },
        "reinforced": false
      },
      "now": 4.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 5.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 5.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 6.0
      },
      "expect": {
        "meta": {
          "timeout_started": true
        },
        "reinforced": true,
        "reinforcer": {
          "label": "SR+",
          "magnitude": 1.0,
          "time": 6.0
        }
      },
      "now": 6.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 7.0
      },
      "expect": {
        "meta": {
          "timeout_active": true
        },
        "reinforced": false
      },
      "now": 7.0
    }
  ]
}
