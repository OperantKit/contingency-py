{
  "description": "FR 5: every 5th response produces a reinforcer.",
  "name": "fr5-basic",
  "schedule": {
    "params": {
      "n": 5
    },
    "type": "FR"
  },
  "steps": [
    {
      "event": null,
      "expect": {
        "reinforced": false
      },
      "now": 0.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 1.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 1.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 2.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 2.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 3.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 3.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 4.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 4.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 5.0
      },
      "expect": {
        "reinforced": true,
        "reinforcer": {
          "label": "SR+",
          "magnitude": 1.0,
          "time": 5.0
        }
      },
      "now": 5.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 6.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 6.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 7.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 7.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 8.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 8.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 9.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 9.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 10.0
      },
      "expect": {
        "reinforced": true,
        "reinforcer": {
          "label": "SR+",
          "magnitude": 1.0,
          "time": 10.0
        }
      },
      "now": 10.0
    }
  ]
}
