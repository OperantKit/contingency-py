{
  "description": "FI 10: response after 10s elapsed reinforces; responses before the interval do not reset the clock.",
  "name": "fi10-basic",
  "schedule": {
    "params": {
      "interval": 10.0
    },
    "type": "FI"
  },
  "steps": [
    {
      "event": {
        "operandum": "main",
        "time": 0.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 0.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 5.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 5.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 9.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 9.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 10.0
      },
      "expect": {
        "reinforced": true,
        "reinforcer": {
          "label": "SR+",
          "magnitude": 1.0,
          "time": 10.0
        }
      },
      "now": 10.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 15.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 15.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 20.0
      },
      "expect": {
        "reinforced": true,
        "reinforcer": {
          "label": "SR+",
          "magnitude": 1.0,
          "time": 20.0
        }
      },
      "now": 20.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 21.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 21.0
    }
  ]
}
