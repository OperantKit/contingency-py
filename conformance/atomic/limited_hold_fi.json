{
  "description": "LimitedHold wrapping FI 5 with a 2s availability window. A response at t=6 reinforces; a response at t=8 (outside the window opened at t=10) does not; ticks at later times withdraw expired opportunities.",
  "name": "limited-hold-fi5-hold2",
  "schedule": {
    "params": {
      "hold": 2.0,
      "inner": {
        "params": {
          "interval": 5.0
        },
        "type": "FI"
      }
    },
    "type": "LimitedHold"
  },
  "steps": [
    {
      "event": {
        "operandum": "main",
        "time": 0.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 0.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 1.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 1.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 4.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 4.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 6.0
      },
      "expect": {
        "reinforced": true,
        "reinforcer": {
          "label": "SR+",
          "magnitude": 1.0,
          "time": 6.0
        }
      },
      "now": 6.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 10.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 10.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 11.5
      },
      "expect": {
        "reinforced": true,
        "reinforcer": {
          "label": "SR+",
          "magnitude": 1.0,
          "time": 11.5
        }
      },
      "now": 11.5
    },
    {
      "event": null,
      "expect": {
        "reinforced": false
      },
      "now": 20.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 30.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 30.0
    }
  ]
}
