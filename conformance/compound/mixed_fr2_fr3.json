{
  "description": "Mixed FR(2) / FR(3): the same component sequence as Multiple but with no S^D. On reinforcement the active index advances and wraps after the last component; current_component is the integer index.",
  "name": "mixed-fr2-fr3",
  "schedule": {
    "params": {
      "components": [
        {
          "params": {
            "n": 2
          },
          "type": "FR"
        },
        {
          "params": {
            "n": 3
          },
          "type": "FR"
        }
      ]
    },
    "type": "Mixed"
  },
  "steps": [
    {
      "event": {
        "operandum": "main",
        "time": 1.0
      },
      "expect": {
        "meta": {
          "current_component": 0
        },
        "reinforced": false
      },
      "now": 1.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 2.0
      },
      "expect": {
        "meta": {
          "current_component": 0
        },
        "reinforced": true,
        "reinforcer": {
          "label": "SR+",
          "magnitude": 1.0,
          "time": 2.0
        }
      },
      "now": 2.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 3.0
      },
      "expect": {
        "meta": {
          "current_component": 1
        },
        "reinforced": false
      },
      "now": 3.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 4.0
      },
      "expect": {
        "meta": {
          "current_component": 1
        },
        "reinforced": false
      },
      "now": 4.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 5.0
      },
      "expect": {
        "meta": {
          "current_component": 1
        },
        "reinforced": true,
        "reinforcer": {
          "label": "SR+",
          "magnitude": 1.0,
          "time": 5.0
        }
      },
      "now": 5.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 6.0
      },
      "expect": {
        "meta": {
          "current_component": 0
        },
        "reinforced": false
      },
      "now": 6.0
    }
  ]
}
