{
  "description": "Chained FR(2) -> FR(3): 2 responses complete the first link (conditioned reinforcement, no primary), 3 more responses complete the terminal and deliver primary SR+.",
  "name": "chained-fr2-fr3",
  "schedule": {
    "params": {
      "components": [
        {
          "params": {
            "n": 2
          },
          "type": "FR"
        },
        {
          "params": {
            "n": 3
          },
          "type": "FR"
        }
      ],
      "stimuli": [
        "s0",
        "s1"
      ]
    },
    "type": "Chained"
  },
  "steps": [
    {
      "event": {
        "operandum": "main",
        "time": 1.0
      },
      "expect": {
        "meta": {
          "current_component": "s0"
        },
        "reinforced": false
      },
      "now": 1.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 2.0
      },
      "expect": {
        "meta": {
          "chain_transition": true,
          "current_component": "s1"
        },
        "reinforced": false
      },
      "now": 2.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 3.0
      },
      "expect": {
        "meta": {
          "current_component": "s1"
        },
        "reinforced": false
      },
      "now": 3.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 4.0
      },
      "expect": {
        "meta": {
          "current_component": "s1"
        },
        "reinforced": false
      },
      "now": 4.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 5.0
      },
      "expect": {
        "meta": {
          "current_component": "s0"
        },
        "reinforced": true,
        "reinforcer": {
          "label": "SR+",
          "magnitude": 1.0,
          "time": 5.0
        }
      },
      "now": 5.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 6.0
      },
      "expect": {
        "meta": {
          "current_component": "s0"
        },
        "reinforced": false
      },
      "now": 6.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 7.0
      },
      "expect": {
        "meta": {
          "chain_transition": true,
          "current_component": "s1"
        },
        "reinforced": false
      },
      "now": 7.0
    }
  ]
}
