{
  "description": "Timeout 3s wrapping FR 2: responses during timeout are dropped (meta timeout_active).",
  "name": "timeout-fr2-to3",
  "schedule": {
    "params": {
      "duration": 3.0,
      "inner": {
        "params": {
          "n": 2
        },
        "type": "FR"
      },
      "reset_on_response": false
    },
    "type": "Timeout"
  },
  "steps": [
    {
      "event": {
        "operandum": "main",
        "time": 1.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 1.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 2.0
      },
      "expect": {
        "meta": {
          "timeout_started": true
        },
        "reinforced": true,
        "reinforcer": {
          "label": "SR+",
          "magnitude": 1.0,
          "time": 2.0
        }
      },
      "now": 2.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 3.0
      },
      "expect": {
        "meta": {
          "timeout_active": true
        },
        "reinforced": false
      },
      "now": 3.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 4.0
      },
      "expect": {
        "meta": {
          "timeout_active": true
        },
        "reinforced": false
      },
      "now": 4.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 5.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 5.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 6.0
      },
      "expect": {
        "meta": {
          "timeout_started": true
        },
        "reinforced": true,
        "reinforcer": {
          "label": "SR+",
          "magnitude": 1.0,
          "time": 6.0
        }
      },
      "now": 6.0
    },
    {
      "event": null,
      "expect": {
        "meta": {
          "timeout_active": true
        },
        "reinforced": false
      },
      "now": 7.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 10.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 10.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 11.0
      },
      "expect": {
        "meta": {
          "timeout_started": true
        },
        "reinforced": true,
        "reinforcer": {
          "label": "SR+",
          "magnitude": 1.0,
          "time": 11.0
        }
      },
      "now": 11.0
    }
  ]
}
