      "expect": {
        "meta": {
          "base_fired": false,
          "punisher_fired": true
        },
        "reinforced": true,
        "reinforcer": {
          "label": "SR-",
          "magnitude": -1.0,
          "time": 8.0
        }
      },
      "now": 8.0
