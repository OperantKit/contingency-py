{
  "description": "Overlay base FR(3) with punisher FR(2): SR+ on 3, SR- on 2 and 4, SR0 (net 0) on 6.",
  "name": "overlay-fr3-fr2",
  "schedule": {
    "params": {
      "base": {
        "params": {
          "n": 3
        },
        "type": "FR"
      },
      "punisher": {
        "params": {
          "n": 2
        },
        "type": "FR"
      }
    },
    "type": "Overlay"
  },
  "steps": [
    {
      "event": {
        "operandum": "main",
        "time": 1.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 1.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 2.0
      },
      "expect": {
        "meta": {
          "base_fired": false,
          "punisher_fired": true
        },
        "reinforced": true,
        "reinforcer": {
          "label": "SR-",
          "magnitude": -1.0,
          "time": 2.0
        }
      },
      "now": 2.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 3.0
      },
      "expect": {
        "meta": {
          "base_fired": true,
          "punisher_fired": false
        },
        "reinforced": true,
        "reinforcer": {
          "label": "SR+",
          "magnitude": 1.0,
          "time": 3.0
        }
      },
      "now": 3.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 4.0
      },
      "expect": {
        "meta": {
          "base_fired": false,
          "punisher_fired": true
        },
        "reinforced": true,
        "reinforcer": {
          "label": "SR-",
          "magnitude": -1.0,
          "time": 4.0
        }
      },
      "now": 4.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 5.0
      },
      "expect": {
        "reinforced": false
      },
      "now": 5.0
    },
    {
      "event": {
        "operandum": "main",
        "time": 6.0
      },
      "expect": {
        "meta": {
          "base_fired": true,
